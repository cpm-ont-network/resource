    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/cr#accessory -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#accessory">
        <rdfs:domain rdf:resource="https://w3id.org/cr#EquipmentResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="it">Indica se un&apos;EquipmentResource è considerata una risorsa accessoria nell&apos;ambito del suo utilizzo costruttivo o della relativa descrizione di costo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether an EquipmentResource is considered an accessory resource within its construction use or cost description.</rdfs:comment>
        <rdfs:label>accessory</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#cam -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#cam">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cr#EquipmentResource"/>
                    <rdf:Description rdf:about="https://w3id.org/cr#MaterialResource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="it">Indica se una MaterialResource o EquipmentResource è associata ai requisiti applicabili dei Criteri Ambientali Minimi (CAM) italiani.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether a MaterialResource or EquipmentResource is associated with the applicable Italian Minimum Environmental Criteria (CAM) requirements.</rdfs:comment>
        <rdfs:label>cam</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#code -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#code">
        <rdfs:domain rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Specifica l&apos;identificatore o il codice di catalogo assegnato a una Resource.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the identifier or catalogue code assigned to a Resource.</rdfs:comment>
        <rdfs:label>code</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#descriptionDetail -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#descriptionDetail">
        <rdfs:domain rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Fornisce la descrizione testuale di dettaglio di una Resource, integrando la descrizione generale con informazioni più specifiche.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides the detailed textual description of a Resource, complementing its general description with more specific information.</rdfs:comment>
        <rdfs:label>descriptionDetail</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#descriptionGeneral -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#descriptionGeneral">
        <rdfs:domain rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Fornisce la descrizione testuale generale utilizzata per identificare e sintetizzare una Resource.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides the general textual description used to identify and summarize a Resource.</rdfs:comment>
        <rdfs:label>descriptionGeneral</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#excluded -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#excluded">
        <rdfs:domain rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Specifica, in forma testuale, voci, operazioni, condizioni o prescrizioni esplicitamente escluse dall&apos;ambito di una Resource.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies, in textual form, items, operations, conditions, or provisions that are explicitly excluded from the scope of a Resource.</rdfs:comment>
        <rdfs:label>excluded</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#hasLagDuration -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#hasLagDuration">
        <rdfs:domain rdf:resource="https://w3id.org/cr#LagPrecondition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="it">Specifica la durata numerica del ritardo temporale rappresentato da una LagPrecondition.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the numerical duration of the time lag represented by a LagPrecondition.</rdfs:comment>
        <rdfs:label>hasLagDuration</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#hasLagStart -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#hasLagStart">
        <rdfs:domain rdf:resource="https://w3id.org/cr#LagPrecondition"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="it">Specifica la data e l&apos;ora a partire dalle quali inizia il ritardo rappresentato da una LagPrecondition.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the date and time from which the lag represented by a LagPrecondition starts.</rdfs:comment>
        <rdfs:label>hasLagStart</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#included -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#included">
        <rdfs:domain rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Specifica, in forma testuale, voci, operazioni, condizioni o prescrizioni esplicitamente incluse nell&apos;ambito di una Resource.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies, in textual form, items, operations, conditions, or provisions that are explicitly included in the scope of a Resource.</rdfs:comment>
        <rdfs:label>included</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#keywords -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#keywords">
        <rdfs:domain rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Fornisce una o più parole chiave testuali che supportano l&apos;identificazione, la ricerca o l&apos;indicizzazione semantica di una Resource.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides one or more textual keywords that support the identification, search, or semantic indexing of a Resource.</rdfs:comment>
        <rdfs:label>keywords</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#law -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#law">
        <rdfs:domain rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Fornisce riferimenti testuali a leggi, regolamenti o altre disposizioni normative applicabili a una Resource.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides textual references to laws, regulations, or other legal provisions applicable to a Resource.</rdfs:comment>
        <rdfs:label>law</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#measurementRules -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#measurementRules">
        <rdfs:domain rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Fornisce le regole o convenzioni da seguire nella misurazione o quantificazione di una Resource ai fini costruttivi o di stima dei costi.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides the rules or conventions to be followed when measuring or quantifying a Resource for construction or cost-estimation purposes.</rdfs:comment>
        <rdfs:label>measurement rules</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#minimumLabourResourceLevel -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#minimumLabourResourceLevel">
        <rdfs:domain rdf:resource="https://w3id.org/cr#EquipmentResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Specifica il livello minimo di risorsa di manodopera richiesto o associato all&apos;utilizzo o al funzionamento di un&apos;EquipmentResource.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the minimum labour-resource level required or associated with the use or operation of an EquipmentResource.</rdfs:comment>
        <rdfs:label>minimumLabourResourceLevel</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#quantityUnitOfMeasure -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#quantityUnitOfMeasure">
        <rdfs:domain rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="it">Specifica la quantità di riferimento associata all&apos;unità di misura e al prezzo unitario di una Resource, ad esempio un prezzo espresso per 100 pezzi.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the reference quantity associated with the unit of measure and unit price of a Resource, for example a price expressed per 100 pieces.</rdfs:comment>
        <rdfs:label>quantityUnitOfMeasure</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#refParamFormula -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#refParamFormula">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cr#refParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/cr#CostItemToGeometryAssignment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Specifica l&apos;espressione o formula utilizzata per derivare, dalle informazioni del modello, la quantità associata a un CostItemToGeometryAssignment.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the expression or formula used to derive the quantity associated with a CostItemToGeometryAssignment from model information.</rdfs:comment>
        <rdfs:label>ref param formula</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#refParamQuantity -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#refParamQuantity">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cr#refParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/cr#CostItemToGeometryAssignment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="it">Specifica la quantità derivata dall&apos;elemento geometrico referenziato e applicata alla voce di costo associata per il calcolo del costo basato sulle quantità.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the quantity derived from the referenced geometrical element and applied to the associated cost item for quantity-based cost calculation.</rdfs:comment>
        <rdfs:label>quantity</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#refParamUtilizationFactor -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#refParamUtilizationFactor">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cr#refParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/cr#ResourceToCostItemAssignment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="it">Specifica il fattore di utilizzo di una Resource quando è assegnata e contabilizzata all&apos;interno di una voce di costo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the utilization factor of a Resource when it is assigned to and accounted for within a cost item.</rdfs:comment>
        <rdfs:label>utilization factor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#refParamUtilizationRate -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#refParamUtilizationRate">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cr#refParameter"/>
        <rdfs:domain rdf:resource="https://w3id.org/cr#ResourceToTaskAssignment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="it">Specifica il tasso con cui una Resource è allocata o utilizzata nel task referenziato da un ResourceToTaskAssignment.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the rate at which a Resource is allocated to or used in the task referenced by a ResourceToTaskAssignment.</rdfs:comment>
        <rdfs:label>utilization rate</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#refParameter -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#refParameter">
        <rdfs:domain rdf:resource="https://w3id.org/cr#Assignment"/>
        <rdfs:comment xml:lang="en">A generic datatype property for literal parameters that characterize an Assignment, such as quantities, formulas, utilization factors, or utilization rates.</rdfs:comment>
        <rdfs:comment xml:lang="it">Una proprietà datatype generica per parametri letterali che caratterizzano un Assignment, come quantità, formule, fattori di utilizzo o tassi di utilizzo.</rdfs:comment>
        <rdfs:label>ref parameter</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#rent -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#rent">
        <rdfs:domain rdf:resource="https://w3id.org/cr#EquipmentResource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="it">Indica se un&apos;EquipmentResource è rappresentata come risorsa a noleggio.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether an EquipmentResource is represented as a rented resource.</rdfs:comment>
        <rdfs:label>rent</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#techSpecs -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#techSpecs">
        <rdfs:domain rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Fornisce specifiche tecniche testuali, prescrizioni o requisiti associati a una Resource.</rdfs:comment>
        <rdfs:comment xml:lang="en">Provides textual technical specifications, prescriptions, or requirements associated with a Resource.</rdfs:comment>
        <rdfs:label>tech specs</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#unitPrice -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#unitPrice">
        <rdfs:domain rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:comment xml:lang="it">Specifica il prezzo monetario di una Resource per la quantità di riferimento e l&apos;unità di misura dichiarate.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the monetary price of a Resource per its declared reference quantity and unit of measure.</rdfs:comment>
        <rdfs:label>unit price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cr#yield -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cr#yield">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cr#EquipmentResource"/>
                    <rdf:Description rdf:about="https://w3id.org/cr#MaterialResource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="it">Specifica informazioni relative alla resa, alla produttività o all&apos;output associate a una MaterialResource o EquipmentResource.</rdfs:comment>
        <rdfs:comment xml:lang="en">Specifies the yield, productivity, or output-related information associated with a MaterialResource or EquipmentResource.</rdfs:comment>
        <rdfs:label>yield</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://w3id.org/cterm#parameterSymbol1 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cterm#parameterSymbol1"/>
    


    <!-- https://w3id.org/cterm#parameterSymbol2 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cterm#parameterSymbol2"/>
    


    <!-- https://w3id.org/cterm#parameterValue1 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cterm#parameterValue1"/>
    


    <!-- https://w3id.org/cterm#parameterValue2 -->


    <owl:DatatypeProperty rdf:about="https://w3id.org/cterm#parameterValue2"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://ifcowl.openbimstandards.org/ifcOWL#IfcProduct -->


    <owl:Class rdf:about="http://ifcowl.openbimstandards.org/ifcOWL#IfcProduct"/>
    


    <!-- http://qudt.org/schema/qudt/Unit -->


    <owl:Class rdf:about="http://qudt.org/schema/qudt/Unit"/>
    


    <!-- http://www.w3.org/2000/01/rdf-schema#Resource -->


    <owl:Class rdf:about="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    


    <!-- https://dtc-ontology.cms.ed.tum.de/ontology#AsPerformedEquipment -->


    <owl:Class rdf:about="https://dtc-ontology.cms.ed.tum.de/ontology#AsPerformedEquipment">
        <owl:equivalentClass rdf:resource="https://w3id.org/cr#EquipmentResource"/>
    </owl:Class>
    


    <!-- https://dtc-ontology.cms.ed.tum.de/ontology#AsPerformedMaterial -->


    <owl:Class rdf:about="https://dtc-ontology.cms.ed.tum.de/ontology#AsPerformedMaterial">
        <owl:equivalentClass rdf:resource="https://w3id.org/cr#MaterialResource"/>
    </owl:Class>
    


    <!-- https://dtc-ontology.cms.ed.tum.de/ontology#AsPerformedWorker -->


    <owl:Class rdf:about="https://dtc-ontology.cms.ed.tum.de/ontology#AsPerformedWorker">
        <owl:equivalentClass rdf:resource="https://w3id.org/cr#LabourResource"/>
    </owl:Class>
    


    <!-- https://dtc-ontology.cms.ed.tum.de/ontology#Precondition -->


    <owl:Class rdf:about="https://dtc-ontology.cms.ed.tum.de/ontology#Precondition"/>
    


    <!-- https://dtc-ontology.cms.ed.tum.de/ontology#Resource -->


    <owl:Class rdf:about="https://dtc-ontology.cms.ed.tum.de/ontology#Resource">
        <owl:equivalentClass rdf:resource="https://w3id.org/cr#Resource"/>
    </owl:Class>
    


    <!-- https://dtc-ontology.cms.ed.tum.de/ontology#ResourceAssignment -->


    <owl:Class rdf:about="https://dtc-ontology.cms.ed.tum.de/ontology#ResourceAssignment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cr#ResourceToTaskAssignment"/>
    </owl:Class>
    


    <!-- https://dtc-ontology.cms.ed.tum.de/ontology#Task -->


    <owl:Class rdf:about="https://dtc-ontology.cms.ed.tum.de/ontology#Task"/>
    


    <!-- https://schema.org/Person -->


    <owl:Class rdf:about="https://schema.org/Person"/>
    


    <!-- https://w3id.org/ci#CostItem -->


    <owl:Class rdf:about="https://w3id.org/ci#CostItem"/>
    


    <!-- https://w3id.org/ci#ProductionResult -->


    <owl:Class rdf:about="https://w3id.org/ci#ProductionResult"/>
    


    <!-- https://w3id.org/cr#Assignment -->


    <owl:Class rdf:about="https://w3id.org/cr#Assignment">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#isAssignmentOf"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cr#AssignmentSet"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A reified relationship used to connect construction-domain entities through an explicit assignment that can carry assignment-specific references and parameters and can be grouped within an AssignmentSet.</rdfs:comment>
        <rdfs:comment xml:lang="it">Una relazione reificata utilizzata per collegare entità del dominio delle costruzioni mediante un&apos;assegnazione esplicita, che può contenere riferimenti e parametri specifici dell&apos;assegnazione e può essere raggruppata in un AssignmentSet.</rdfs:comment>
        <rdfs:label xml:lang="en">Assignment</rdfs:label>
        <rdfs:label xml:lang="it">Relazione</rdfs:label>
        <rdfs:label xml:lang="de">Zuweisung</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cr#AssignmentSet -->


    <owl:Class rdf:about="https://w3id.org/cr#AssignmentSet">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#hasAssignment"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/cr#Assignment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A collection of related Assignment instances used to organize explicit relationships among resources, tasks, cost items, and geometry within a construction information context.</rdfs:comment>
        <rdfs:comment xml:lang="it">Una raccolta di istanze di Assignment correlate, utilizzata per organizzare relazioni esplicite tra risorse, task, voci di costo e geometrie all&apos;interno di un contesto informativo delle costruzioni.</rdfs:comment>
        <rdfs:label>Assignment set</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cr#Consumption -->


    <owl:Class rdf:about="https://w3id.org/cr#Consumption">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#parameterType"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#ParameterType"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#hasUnit"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://qudt.org/schema/qudt/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#parameterSymbol1"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#parameterSymbol2"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#parameterValue1"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#parameterValue2"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/cterm#Parameter"/>
        <rdfs:comment xml:lang="en">A structured description of the consumption associated with a material or equipment resource, expressed through parameter values, symbols, parameter types, and, where applicable, a unit of measure.</rdfs:comment>
        <rdfs:comment xml:lang="it">Una descrizione strutturata del consumo associato a una risorsa materiale o a un&apos;attrezzatura, espressa mediante valori di parametro, simboli, tipi di parametro e, ove applicabile, un&apos;unità di misura.</rdfs:comment>
        <rdfs:label xml:lang="it">Consumo</rdfs:label>
        <rdfs:label xml:lang="en">Consumption</rdfs:label>
        <rdfs:label xml:lang="de">Verbrauch</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cr#CostItemToGeometryAssignment -->


    <owl:Class rdf:about="https://w3id.org/cr#CostItemToGeometryAssignment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cr#Assignment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#refCostItem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ci#CostItem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#refGeometry"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ifcowl.openbimstandards.org/ifcOWL#IfcProduct"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#refParamFormula"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#refParamQuantity"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/cr#ResourceToCostItemAssignment"/>
        <owl:disjointWith rdf:resource="https://w3id.org/cr#ResourceToTaskAssignment"/>
        <owl:disjointWith rdf:resource="https://w3id.org/cr#TaskToCostItemAssignment"/>
        <owl:disjointWith rdf:resource="https://w3id.org/cr#TaskToGeometryAssignment"/>
        <rdfs:comment xml:lang="en">An assignment that links a cost item to an IFC product representing the corresponding geometrical or physical object and stores the formula and quantity used to relate model geometry to cost estimation.</rdfs:comment>
        <rdfs:comment xml:lang="it">Un&apos;assegnazione che collega una voce di costo a un prodotto IFC che rappresenta il corrispondente oggetto geometrico o fisico e memorizza la formula e la quantità utilizzate per mettere in relazione la geometria del modello con la stima dei costi.</rdfs:comment>
        <rdfs:label xml:lang="en">Cost item to geometry assignment</rdfs:label>
        <rdfs:label xml:lang="it">Relazione tra costo e geometria</rdfs:label>
        <rdfs:label xml:lang="de">Zuordnung von Kostenbestandteilen zu Geometrieobjekten</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cr#EquipmentResource -->


    <owl:Class rdf:about="https://w3id.org/cr#EquipmentResource">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasAspect"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#AspectOfEquipment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasCategory"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#CategoryOfEquipment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasDimensionParameter"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#DimensionParameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasFamily"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#FamilyOfEquipment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasFunction"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#FunctionOfEquipment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasMaterial"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#Material"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasObject"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#ObjectOfEquipment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasObjectStandard"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#Standard"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasOtherStandard"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#Standard"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasPerformanceParameter"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#PerformanceParameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasPhysicalParameter"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#PhysicalParameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasType"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#TypeOfEquipment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasUse"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#Use"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#accessory"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#rent"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#minimumLabourResourceLevel"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/cr#LabourResource"/>
        <owl:disjointWith rdf:resource="https://w3id.org/cr#MaterialResource"/>
        <rdfs:comment xml:lang="en">A construction resource representing equipment, machinery, tools, or other technical means used to execute or support construction activities. It can be characterized by classification, material, dimensional, performance, physical, functional, use, regulatory, and resource-specific information.</rdfs:comment>
        <rdfs:comment xml:lang="it">Una risorsa delle costruzioni che rappresenta attrezzature, macchinari, utensili o altri mezzi tecnici utilizzati per eseguire o supportare attività di costruzione. Può essere caratterizzata mediante informazioni di classificazione, materiale, dimensionali, prestazionali, fisiche, funzionali, d&apos;uso, normative e specifiche della risorsa.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcconstructionmgmtdomain/lexical/ifcconstructionequipmentresource.htm"/>
        <rdfs:label xml:lang="en">Equipment resource</rdfs:label>
        <rdfs:label xml:lang="de">Geräteressource</rdfs:label>
        <rdfs:label xml:lang="it">Risorsa strumentale</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cr#LabourResource -->


    <owl:Class rdf:about="https://w3id.org/cr#LabourResource">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasCategory"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#CategoryOfLabour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasFamily"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#FamilyOfLabour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasObject"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#ObjectOfLabour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasQualificationLevel"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#QualificationLevel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasType"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#TypeOfLabour"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/cr#MaterialResource"/>
        <rdfs:comment xml:lang="en">A construction resource representing human labour required to perform construction activities, characterized by its classification, type, role or object, and qualification level.</rdfs:comment>
        <rdfs:comment xml:lang="it">Una risorsa delle costruzioni che rappresenta la manodopera necessaria per eseguire attività di costruzione, caratterizzata da classificazione, tipo, ruolo o oggetto e livello di qualificazione.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcconstructionmgmtdomain/lexical/ifclaborresource.htm"/>
        <rdfs:label xml:lang="de">Arbeitsressourcen</rdfs:label>
        <rdfs:label xml:lang="en">Labour resource</rdfs:label>
        <rdfs:label xml:lang="it">Risorsa umana</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cr#LagPrecondition -->


    <owl:Class rdf:about="https://w3id.org/cr#LagPrecondition">
        <rdfs:subClassOf rdf:resource="https://dtc-ontology.cms.ed.tum.de/ontology#Precondition"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#hasLagUnit"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onClass rdf:resource="http://qudt.org/schema/qudt/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#hasLagDuration"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#hasLagStart"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A precondition that specifies a time lag that must elapse before a subsequent task or activity can start, including the lag duration, its unit, and, where applicable, the lag start time.</rdfs:comment>
        <rdfs:comment xml:lang="it">Una precondizione che specifica un intervallo temporale che deve trascorrere prima che un task o un&apos;attività successiva possa iniziare, includendo la durata del ritardo, la relativa unità e, ove applicabile, l&apos;istante di inizio del ritardo.</rdfs:comment>
        <rdfs:label>Lag Precondition</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cr#MaterialResource -->


    <owl:Class rdf:about="https://w3id.org/cr#MaterialResource">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasAspect"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#AspectOfMaterial"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasCategory"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#CategoryOfMaterial"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasDimensionParameter"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#DimensionParameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasFamily"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#FamilyOfMaterial"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasFinishing"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#Finishing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasFunction"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#FunctionOfMaterial"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasFurnishing"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#Furnishing"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasMaterial"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#Material"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasObject"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#ObjectOfMaterial"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasObjectStandard"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#Standard"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasOtherStandard"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#Standard"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasPerformanceParameter"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#PerformanceParameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasPhysicalParameter"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#PhysicalParameter"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasType"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#TypeOfMaterial"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cterm#hasUse"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/cterm#Use"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#cam"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A construction resource representing a material or product that can be consumed wholly or partly in the realization of a construction result. It can be characterized by classification, material, dimensional, physical, performance, functional, use, finishing, furnishing, and regulatory information.</rdfs:comment>
        <rdfs:comment xml:lang="it">Una risorsa delle costruzioni che rappresenta un materiale o prodotto che può essere consumato totalmente o parzialmente nella realizzazione di un risultato costruttivo. Può essere caratterizzata mediante informazioni di classificazione, materiale, dimensionali, fisiche, prestazionali, funzionali, d&apos;uso, di finitura, di fornitura e normative.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifcconstructionmgmtdomain/lexical/ifcconstructionmaterialresource.htm"/>
        <rdfs:label xml:lang="en">Material resource</rdfs:label>
        <rdfs:label xml:lang="de">Materielle Ressource</rdfs:label>
        <rdfs:label xml:lang="it">Risorsa materiale</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cr#Resource -->


    <owl:Class rdf:about="https://w3id.org/cr#Resource">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#hasUnit"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://qudt.org/schema/qudt/Unit"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#keywords"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#law"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#code"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#descriptionGeneral"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#quantityUnitOfMeasure"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#unitPrice"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#descriptionDetail"/>
                <owl:maxQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxQualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A generic construction production factor used in planning, execution, or cost estimation. A Resource carries identifying and descriptive information together with its reference quantity, unit of measure, and unit price, and can be specialized as a material, equipment, or labour resource.</rdfs:comment>
        <rdfs:comment xml:lang="it">Un fattore produttivo generico delle costruzioni utilizzato nella pianificazione, nell&apos;esecuzione o nella stima dei costi. Una Resource contiene informazioni identificative e descrittive insieme alla quantità di riferimento, all&apos;unità di misura e al prezzo unitario e può essere specializzata come risorsa materiale, attrezzatura o manodopera.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://standards.buildingsmart.org/IFC/RELEASE/IFC4_1/FINAL/HTML/schema/ifckernel/lexical/ifcresource.htm"/>
        <rdfs:label xml:lang="en">Resource</rdfs:label>
        <rdfs:label xml:lang="de">Ressource</rdfs:label>
        <rdfs:label xml:lang="it">Risorsa</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cr#ResourceToCostItemAssignment -->


    <owl:Class rdf:about="https://w3id.org/cr#ResourceToCostItemAssignment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cr#Assignment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#refCostItem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ci#CostItem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#refResource"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/cr#Resource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/cr#ResourceToTaskAssignment"/>
        <owl:disjointWith rdf:resource="https://w3id.org/cr#TaskToCostItemAssignment"/>
        <owl:disjointWith rdf:resource="https://w3id.org/cr#TaskToGeometryAssignment"/>
        <rdfs:comment xml:lang="en">An assignment that links a construction resource to the cost item in which the resource is used or accounted for, enabling assignment-specific parameters such as a utilization factor to be represented.</rdfs:comment>
        <rdfs:comment xml:lang="it">Un&apos;assegnazione che collega una risorsa delle costruzioni alla voce di costo nella quale la risorsa è utilizzata o contabilizzata, consentendo di rappresentare parametri specifici dell&apos;assegnazione, come un fattore di utilizzo.</rdfs:comment>
        <rdfs:label xml:lang="it">Relazione tra risorsa e costo</rdfs:label>
        <rdfs:label xml:lang="en">Resource to cost item assignment</rdfs:label>
        <rdfs:label xml:lang="de">Zuordnung von Ressourcen zu Kostenbestandteilen</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cr#ResourceToTaskAssignment -->


    <owl:Class rdf:about="https://w3id.org/cr#ResourceToTaskAssignment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cr#Assignment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#refResource"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/cr#Resource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#refTask"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://dtc-ontology.cms.ed.tum.de/ontology#Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#refParamUtilizationRate"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onDataRange rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/cr#TaskToCostItemAssignment"/>
        <owl:disjointWith rdf:resource="https://w3id.org/cr#TaskToGeometryAssignment"/>
        <rdfs:comment xml:lang="en">An assignment that links a construction resource to the task in which it is used and can record the resource utilization rate associated with that task.</rdfs:comment>
        <rdfs:comment xml:lang="it">Un&apos;assegnazione che collega una risorsa delle costruzioni al task nel quale è utilizzata e può registrare il tasso di utilizzo della risorsa associato a tale task.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="https://dtc-ontology.cms.ed.tum.de/ontology#ResourceAssignment"/>
        <rdfs:label xml:lang="it">Relazione tra risorsa e attività</rdfs:label>
        <rdfs:label xml:lang="en">Resource to task assignment</rdfs:label>
        <rdfs:label xml:lang="de">Zuordnung von Ressourcen zu Vorgängen</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cr#TaskToCostItemAssignment -->


    <owl:Class rdf:about="https://w3id.org/cr#TaskToCostItemAssignment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cr#Assignment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#refCostItem"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/ci#CostItem"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#refTask"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://dtc-ontology.cms.ed.tum.de/ontology#Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/cr#TaskToGeometryAssignment"/>
        <rdfs:comment xml:lang="en">An assignment that links a construction task to the cost item or production result to which the task contributes or corresponds.</rdfs:comment>
        <rdfs:comment xml:lang="it">Un&apos;assegnazione che collega un task di costruzione alla voce di costo o al risultato produttivo al quale il task contribuisce o corrisponde.</rdfs:comment>
        <rdfs:label xml:lang="it">Relazione tra attività e costo</rdfs:label>
        <rdfs:label xml:lang="en">Task to cost item assignment</rdfs:label>
        <rdfs:label xml:lang="de">Zuordnung von Vorgängen zu Kostenbestandteilen</rdfs:label>
    </owl:Class>
    


    <!-- https://w3id.org/cr#TaskToGeometryAssignment -->


    <owl:Class rdf:about="https://w3id.org/cr#TaskToGeometryAssignment">
        <rdfs:subClassOf rdf:resource="https://w3id.org/cr#Assignment"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#refGeometry"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://ifcowl.openbimstandards.org/ifcOWL#IfcProduct"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/cr#refTask"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://dtc-ontology.cms.ed.tum.de/ontology#Task"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">An assignment that links a construction task to an IFC product representing the geometrical or physical object on which the task is performed or to which it refers.</rdfs:comment>
        <rdfs:comment xml:lang="it">Un&apos;assegnazione che collega un task di costruzione a un prodotto IFC che rappresenta l&apos;oggetto geometrico o fisico sul quale il task viene eseguito o al quale fa riferimento.</rdfs:comment>
        <rdfs:label xml:lang="it">Relazione tra attività e geometria</rdfs:label>
        <rdfs:label xml:lang="en">Task to geometry assignment</rdfs:label>
        <rdfs:label xml:lang="de">Zuordnung von Vorgängen zu Geometrieobjekten</rdfs:label>
    </owl:Class>
    


