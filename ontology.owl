    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- https://w3id.org/cr#consumptionOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cr#consumptionOf">
        <owl:inverseOf rdf:resource="https://w3id.org/cr#hasConsumption"/>
        <rdfs:domain rdf:resource="https://w3id.org/cr#Consumption"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cr#EquipmentResource"/>
                    <rdf:Description rdf:about="https://w3id.org/cr#MaterialResource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="it">Mette in relazione un&apos;istanza di Consumption con la MaterialResource o EquipmentResource di cui descrive il consumo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a Consumption instance to the MaterialResource or EquipmentResource whose consumption it describes.</rdfs:comment>
        <rdfs:label>consumptionOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cr#hasAssignment -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cr#hasAssignment">
        <owl:inverseOf rdf:resource="https://w3id.org/cr#isAssignmentOf"/>
        <rdfs:domain rdf:resource="https://w3id.org/cr#AssignmentSet"/>
        <rdfs:range rdf:resource="https://w3id.org/cr#Assignment"/>
        <rdfs:comment xml:lang="it">Mette in relazione un AssignmentSet con un Assignment contenuto in tale insieme.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an AssignmentSet to an Assignment contained in that set.</rdfs:comment>
        <rdfs:label>has assignment</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cr#hasConsumption -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cr#hasConsumption">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cr#EquipmentResource"/>
                    <rdf:Description rdf:about="https://w3id.org/cr#MaterialResource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/cr#Consumption"/>
        <rdfs:comment xml:lang="it">Mette in relazione una MaterialResource o EquipmentResource con un&apos;istanza di Consumption che ne descrive le caratteristiche di consumo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a MaterialResource or EquipmentResource to a Consumption instance describing its consumption characteristics.</rdfs:comment>
        <rdfs:label>hasConsumption</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cr#hasLagUnit -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cr#hasLagUnit">
        <rdfs:domain rdf:resource="https://w3id.org/cr#LagPrecondition"/>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:comment xml:lang="it">Mette in relazione una LagPrecondition con l&apos;unità utilizzata per esprimere la durata del ritardo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a LagPrecondition to the unit used to express its lag duration.</rdfs:comment>
        <rdfs:label>hasLagUnit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cr#hasSubResource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cr#hasSubResource">
        <owl:inverseOf rdf:resource="https://w3id.org/cr#subResourceOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:range rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:comment xml:lang="it">Mette in relazione una Resource con un&apos;altra Resource che costituisce una risorsa subordinata o componente nella sua scomposizione gerarchica. La relazione è transitiva.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a Resource to another Resource that forms a subordinate or constituent resource in its hierarchical decomposition. The relation is transitive.</rdfs:comment>
        <rdfs:label>hasSubResource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cr#hasUnit -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cr#hasUnit">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cr#Consumption"/>
                    <rdf:Description rdf:about="https://w3id.org/cr#Resource"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://qudt.org/schema/qudt/Unit"/>
        <rdfs:comment xml:lang="it">Mette in relazione una Resource o Consumption con l&apos;unità QUDT nella quale è espresso il relativo valore o la quantità di riferimento.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a Resource or Consumption to the QUDT unit in which its value or reference quantity is expressed.</rdfs:comment>
        <rdfs:label>hasUnit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cr#isAssignmentOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cr#isAssignmentOf">
        <rdfs:domain rdf:resource="https://w3id.org/cr#Assignment"/>
        <rdfs:range rdf:resource="https://w3id.org/cr#AssignmentSet"/>
        <rdfs:comment xml:lang="it">Mette in relazione un Assignment con l&apos;AssignmentSet nel quale è raggruppato.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates an Assignment to the AssignmentSet in which it is grouped.</rdfs:comment>
        <rdfs:label>is assignment Of</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cr#ref -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cr#ref">
        <rdfs:domain rdf:resource="https://w3id.org/cr#Assignment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:comment xml:lang="en">A generic reference property used by an Assignment to point to an entity participating in the represented relationship.</rdfs:comment>
        <rdfs:comment xml:lang="it">Una proprietà di riferimento generica utilizzata da un Assignment per puntare a un&apos;entità che partecipa alla relazione rappresentata.</rdfs:comment>
        <rdfs:label>ref</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cr#refCostItem -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cr#refCostItem">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cr#ref"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cr#CostItemToGeometryAssignment"/>
                    <rdf:Description rdf:about="https://w3id.org/cr#ResourceToCostItemAssignment"/>
                    <rdf:Description rdf:about="https://w3id.org/cr#TaskToCostItemAssignment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/ci#ProductionResult"/>
        <rdfs:comment xml:lang="it">Fa riferimento al CostItem o ProductionResult che partecipa a un&apos;assegnazione riguardante informazioni di costo.</rdfs:comment>
        <rdfs:comment xml:lang="en">References the CostItem or ProductionResult participating in an assignment involving cost information.</rdfs:comment>
        <rdfs:label>ref cost item</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cr#refGeometry -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cr#refGeometry">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cr#ref"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cr#CostItemToGeometryAssignment"/>
                    <rdf:Description rdf:about="https://w3id.org/cr#TaskToGeometryAssignment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://ifcowl.openbimstandards.org/ifcOWL#IfcProduct"/>
        <rdfs:comment xml:lang="it">Fa riferimento al prodotto IFC che rappresenta l&apos;oggetto geometrico o fisico delle costruzioni che partecipa a un&apos;assegnazione.</rdfs:comment>
        <rdfs:comment xml:lang="en">References the IFC product representing the geometrical or physical construction object participating in an assignment.</rdfs:comment>
        <rdfs:label>ref geometry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cr#refResource -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cr#refResource">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cr#ref"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cr#ResourceToCostItemAssignment"/>
                    <rdf:Description rdf:about="https://w3id.org/cr#ResourceToTaskAssignment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:comment xml:lang="it">Fa riferimento alla Resource che partecipa a un&apos;assegnazione riguardante una voce di costo o un task.</rdfs:comment>
        <rdfs:comment xml:lang="en">References the Resource participating in an assignment involving a cost item or a task.</rdfs:comment>
        <rdfs:label>ref resource</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cr#refTask -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cr#refTask">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/cr#ref"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/cr#ResourceToTaskAssignment"/>
                    <rdf:Description rdf:about="https://w3id.org/cr#TaskToCostItemAssignment"/>
                    <rdf:Description rdf:about="https://w3id.org/cr#TaskToGeometryAssignment"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://dtc-ontology.cms.ed.tum.de/ontology#Task"/>
        <rdfs:comment xml:lang="it">Fa riferimento al task di costruzione che partecipa a un&apos;assegnazione riguardante una risorsa, una voce di costo o un oggetto geometrico.</rdfs:comment>
        <rdfs:comment xml:lang="en">References the construction task participating in an assignment involving a resource, cost item, or geometrical object.</rdfs:comment>
        <rdfs:label>ref task</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cr#subResourceOf -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cr#subResourceOf">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:range rdf:resource="https://w3id.org/cr#Resource"/>
        <rdfs:comment xml:lang="it">Mette in relazione una Resource con una Resource padre di cui costituisce una risorsa subordinata o componente. La relazione è transitiva ed è l&apos;inversa di hasSubResource.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relates a Resource to a parent Resource of which it is a subordinate or constituent resource. The relation is transitive and is the inverse of hasSubResource.</rdfs:comment>
        <rdfs:label>subResourceOf</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/cterm#hasAspect -->


    <owl:ObjectProperty rdf:about="https://w3id.org/cterm#hasAspect"/>
    


